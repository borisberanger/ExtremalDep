library(geosphere)
pairs <- t(combn(92,2))
pairs.LLO <- cbind(pairs, lon[pairs[,1]], lat[pairs[,1]], lon[pairs[,2]], lat[pairs[,2]])
pairs.LLO <- cbind(pairs, cbind(lon,lat)[pairs[,1],], cbind(lon,lat)[pairs[,2],])
pairs.dist <- apply(pairs.LLO, 1, function(x)  distm(x=x[3:4], y=x[5:6], fun=distGeo) )/1000
pairs.EC <- pairs.ECBP <- vector(length=nrow(pairs))
pb <- txtProgressBar(min = 0, max = nrow(pairs), initial = 0, style=3)
S <- simplex(d=2, n=49)
for(i in 1:nrow(pairs)){
setTxtProgressBar(pb,i)
data.tmp <- trans2UFrechet(precip[,pairs[i,]], type="Empirical")
fit.tmp <- beed(data.tmp, S, 2, "md", "emp", k=7)
pairs.ECBP[i] <- fit.tmp$extind
pairs.EC[i] <- 2*madogram(S, data.tmp, "emp")[which(S[,1]==0.5)]
}
close(pb)
par(mar=c(4.2, 4.6, 0.5, 0.5))
plot(pairs.dist, pairs.EC, pch=16, xlab="Distance (km)", ylab=expression(hat(eta)[k]), ylim=c(1,max(pairs.EC)), cex.lab=1.3)
points(pairs.dist, pairs.ECBP, pch=16, col="grey")
abline(h=2, lty=2)
legend(960, 1.18, legend=c("MD", "MD-BP"),
col=c("black", "grey"), pch=16, box.lty=0)
par(mar=c(c(5.1, 4.1, 4.1, 2.1)))
############################################################################
### Section 2.4                                                          ###
### Bernstein polynomials modelling and Bayesian nonparametric inference ###
############################################################################
rm(list=setdiff(ls(), "tstart"))
data(logReturns)
################
### Figure 4 ###
################
# transform maxima into time series:
mm_gbp_usd <- ts(logReturns$USD, start=c(1991,3), end=c(2014,12), frequency=12)
mm_gbp_jpy <- ts(logReturns$JPY, start=c(1991,3), end=c(2014,12), frequency=12)
# Detect seasonality and trend in the time series of maxima:
seas_usd <- stl(mm_gbp_usd, s.window="period")
seas_jpy <- stl(mm_gbp_jpy, s.window="period")
# remove the seasonality and trend from the two series:
mm_gbp_usd_filt <- mm_gbp_usd - rowSums(seas_usd$time.series[,-3])
mm_gbp_jpy_filt <- mm_gbp_jpy - rowSums(seas_jpy$time.series[,-3])
# display the two time series of filtered monthly maxima of daily log-returns:
par(mfrow=c(2,1))
plot(mm_gbp_usd_filt, type="l", main="Monthly maxima of daily log-returns",
xlab="GBP/USD exchange rate", ylab="")
plot(mm_gbp_jpy_filt, type="l", main="Monthly maxima of daily log-returns",
xlab="GBP/JPY exchange rate", ylab="")
# display the dependence between the two series of maxima:
par(mfrow=c(1,1))
plot(mm_gbp_usd_filt, mm_gbp_jpy_filt, main="Scatter plot of monthly maxima of daily log-returns",
xlab="GBP/USD exchange rate", ylab="GBP/JPY exchange rate", pch=16)
###
### Estimation of margins and dependence
###
hyperparam <- list(mu.nbinom = 3.2, var.nbinom = 4.48)
mm_gbp <- cbind(as.vector(mm_gbp_usd_filt), as.vector(mm_gbp_jpy_filt))
set.seed(123)
gbp_mar <- fExtDep.np(x=mm_gbp, method="Bayesian",
par10=rep(0.1, 3), par20=rep(0.1,3), sig10=0.0001, sig20=0.0001, k0=5,
hyperparam = hyperparam, nsim=5e+4)
################
### Figure 5 ###
################
diagnostics(gbp_mar)
################
### Figure 6 ###
################
gbp_mar_sum <- summary(object=gbp_mar, burn=30000, plot=TRUE)
# Computing returns
mm_gbp_range <- apply(mm_gbp,2,quantile,c(0.9,0.995))
y_gbp_usd <- seq(from=mm_gbp_range[1,1], to=mm_gbp_range[2,1], length=20)
y_gbp_jpy <- seq(from=mm_gbp_range[1,2], to=mm_gbp_range[2,2], length=20)
y <- as.matrix(expand.grid(y_gbp_usd, y_gbp_jpy, KEEP.OUT.ATTRS = FALSE))
ret_marg <- returns(x=gbp_mar, summary.mcmc=gbp_mar_sum, y=y, plot=TRUE,
data=mm_gbp, xlab="GBP/USD exchange rate", ylab="GBP/JPY exchange rate")
qs <- apply(mm_gbp,2,quantile,c(0.99))
jointP <- returns(x=gbp_mar, summary.mcmc=gbp_mar_sum, y= matrix(qs, ncol=2) )
par1 <- gbp_mar_sum$mar1.mean
par2 <- gbp_mar_sum$mar2.mean
jointP / pGEV(qs[1], loc=par1[1], scale=par1[2], shape=par1[3], lower.tail=F)
jointP / pGEV(qs[2], loc=par2[1], scale=par2[2], shape=par2[3], lower.tail=F)
####################################
### Section 2.4                  ###
### Simulation of extreme values ###
####################################
rm(list=setdiff(ls(), "tstart"))
data(WindSpeedGust)
years<- format(ParcayMeslay$time, format="%Y")
attach(ParcayMeslay[which(years %in% c(2004:2013)),])
WS_th <- quantile(WS,.9)
DP_th <- quantile(DP,.9)
pars.WS <- evd::fpot(WS, WS_th, model="pp")$estimate
pars.DP <- evd::fpot(DP, DP_th, model="pp")$estimate
# transform the marginal distribution to common unit Fréchet:
data_uf <- trans2UFrechet(cbind(WS,DP), type="Empirical")
rdata <- rowSums(data_uf)
r0 <- quantile(rdata, probs=.90)
extdata <- data_uf[rdata>=r0,]
SP_mle <- fExtDep.np(x=extdata, method="Frequentist", k0=10, type="maxima")
################
### Figure 7 ###
################
plot(x=SP_mle, type="summary")
nsim <- 1000
SP_wsim <- rExtDep(nsim, model="semi.bvevd", par=SP_mle$Ahat$beta, angular=TRUE)
hist(SP_wsim[-which(SP_wsim %in% c(0,1))], prob=TRUE, col="gray", main="", xlab="", ylab="", cex.lab=1.5, cex.axis=1.5)
mtext(expression(omega), side=1, line=3, cex=1.5)
mtext(expression(h(omega)), side=2, line=3, cex=1.5)
points(0, sum(SP_wsim==0)/nsim, pch=17, cex=2, lwd=5)
points(1, sum(SP_wsim==1)/nsim, pch=17, cex=2, lwd=5)
lines(SP_mle$w, SP_mle$hhat, col=2, lwd=2)
points(0, SP_mle$p0, pch=16, cex=2, col=2, lwd=5)
points(1, SP_mle$p1, pch=16, cex=2, col=2, lwd=5)
################
### Figure 8 ###
################
set.seed(10)
SP_exceed_or <- rExtDep(n=200, model="semi.bvexceed", par=SP_mle$Ahat$beta,
mar=rbind(pars.WS, pars.DP), threshold=c(10,20), exceed.type="or")
SP_exceed_and <- rExtDep(n=200, model="semi.bvexceed", par=SP_mle$Ahat$beta,
mar=rbind(pars.WS, pars.DP), threshold=c(10,20), exceed.type="and")
par(mar = c(4, 4.55, 0.25, 0.25))
plot(WS, DP, pch=16, xlim=c(0,max(SP_exceed_and[,1])), ylim=c(0,max(SP_exceed_and[,2])),
xlab="Daily-maximum Wind Speed (m/s)", ylab="Differential of Pressure (mbar)", cex.lab=1.5)
points(SP_exceed_or, pch=16, col=2)
points(SP_exceed_and, pch=16, col=4)
abline(v=10, lty=2)
abline(h=20, lty=2)
################
### Figure 9 ###
################
pF <- pFailure(n=50000, beta=SP_mle$Ahat$beta, u1=seq(from=19, to=28, length=200),
u2=seq(from=40, to=60, length=200), mar1=pars.WS, mar2=pars.DP, type="both",
plot=TRUE, xlab="Daily-maximum Wind Speed (m/s)", ylab="Differential of Pressure (mbar)", nlevels=15)
##############################################
### Section 2.4                            ###
### Estimation of extreme quantile regions ###
##############################################
rm(list=setdiff(ls(), "tstart"))
data(MilanPollution)
data <- Milan.winter[,c("NO2","SO2", "MaxTemp")] #Milan.winter[,c(2,5,8)]
data <- as.matrix(data[complete.cases(data),])
# Covariate matrix (observed temperatures)
covar <- cbind(rep(1,nrow(data)), data[,3], data[,3]^2 )
# Hyperparameters
hyperparam <- list(mu.nbinom = 6, var.nbinom = 8, a.unif=0, b.unif=0.2)
### Modelling dependence and margins
set.seed(123)
pollut <- fExtDep.np(x=data[,-3], method="Bayesian", u=TRUE,
cov1 = covar, cov2 = covar, mar.prelim=FALSE,
par10 = c(100,0,0,35,1), par20 = c(20,0,0,20,1),
sig10 = 0.1, sig20 = 0.1, k0=5,
hyperparam = hyperparam, nsim=15e+3)
#################
### Figure 10 ###
#################
# diagnostics(pollut)
pollut_sum <- summary(object=pollut, burn=5e+3)
Temp.seq <- c(min(data[,3]), median(data[,3]), max(data[,3]) )
QatTemp <- cbind(Temp.seq, Temp.seq^2)
pl <- plot(x=pollut, type="Qsets", summary.mcmc=pollut_sum, QatCov1=QatTemp,
P = 1/c(600, 1200, 2400), dep=TRUE, data=data[,1:2], xlim=c(0,800),
ylim=c(0,800), xlab=expression(NO[2]), ylab=expression(SO[2]) )
########################
### Section 3        ###
### Spatial extremes ###
########################
rm(list=setdiff(ls(), "tstart"))
set.seed(14342)
Ns <- 20; Ny <- 50
sites <- matrix(runif(Ns*2)*10-5,nrow=Ns,ncol=2)
for(i in 1:2) sites[,i] <- sites[,i] - mean(sites[,i])
z <- rExtDepSpat(Ny, sites, model="ET", cov.mod = "powexp",
DoF = 1, range = 3, nugget = 0, smooth = 1.5,
control = list(method = "exact"))
args1 <- list(Nmax=50L, Nmin=5L, eps = 0.001, logeps = FALSE)
args2 <- list(Nmax=500L, Nmin=50L, eps = 0.001, logeps = TRUE)
fit1 <- fExtDepSpat(x=z$vals, model="ET", sites=sites, hit=z$hits,
par0=c(3,1,1), parallel=TRUE, ncores=6,
args1=args1, args2=args2, control = list(trace=0))
est(fit1)
method(fit1)
fit2 <- fExtDepSpat(x=z$vals, model="ET", sites=sites, hit=z$hits,
par0=c(3, 1, 1), jw=3, thresh = quantile(dist(sites), 0.25),
parallel=TRUE, ncores=6,
args1=args1, args2=args2, control = list(trace=0))
est(fit2)
method(fit2)
