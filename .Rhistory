## Husler-Reiss model
Hpar.hr <- list(mean.lambda=0, sd.lambda=3)
PNS.hr <- fExtDep(x=PNS, method="BayesianPPP", model = "HR",
Nsim=5e+4, Nbin=3e+4, Hpar=Hpar.hr, MCpar=0.35, seed=14342)
est(PNS.hr)
StdErr(PNS.hr)
bic(PNS.hr)
par(mar=c(0, 0, 0, 0))
labs <- c(expression(PM[10]), expression(NO), expression(SO[2]))
plot(PNS.hr, labels=labs, cex.lab=2.4)
################
### Figure 2 ###
################
# Requires evd library to be installed
est.fun <- function(x){
unlist(evd::fpot(na.omit(x), threshold=quantile(x, probs=0.7, na.rm=TRUE))[c("threshold", "estimate")])
}
est <- apply(winterdat, 2, est.fun)
transform <- function (x, data, par){
data <- na.omit(data)
if(x > par[1]){
emp.dist <- mean(data <= par[1])
dist <- 1 - ( 1-emp.dist ) * max(0, 1+par[3]*(x-par[1])/par[2])^(-1/par[3])
}else{
dist <- mean(data <= x)
}
return(-1/log(dist))
}
th <- c(95, 270, 110, NA, 95)
Th <- sapply(c(1:3,5), function(x) transform(th[x], data=winterdat[,x], par=est[,x]) )
names(Th) <- colnames(winterdat[c(1:3,5)])
## Probability of excess
par(mar=c(4.5, 4.5, 1, 1))
xl.PNS <- bquote("P(" * PM[10]  ~ ">" ~ .(th[1]) * ", NO" ~ ">" ~ .(th[2]) *
", " * SO[2] ~ ">" ~ .(th[5]) * ")")
P.PNS <- pExtDep(q=Th[colnames(PNS)], type="upper", method="Parametric", model="HR",
par=PNS.hr$stored.vals, xlab=xl.PNS)
## Univariate return level
Q.fix <- c(NA, Th[c(2,4)])
PM10.range <- seq(from=est[1,1], to=400, by=5)
Q.range <- sapply(PM10.range, transform, data=winterdat[,1], par=est[,1])
par(mar=c(4.5, 4.5, 3, 1.8))
set.seed(1)
rl.PM10 <- plot(x=PNS.hr, type="returns", Q.fix=Q.fix, Q.range=Q.range,
Q.range0=PM10.range, labels=expression(PM[10]),
main=bquote("Return level for" ~ PM[10]  ~ "when NO" ~ ">"
~ .(th[2]) ~ "and" ~ SO[2] ~ ">" ~ .(th[5]) ),
cex.lab=1.4, cex.axis=1.4, subsamp=0.05)
# Bivariate return level
Q.fix <- c(NA, NA, Th[4])
PM10.range <- seq(from=est[1,1], to=400, length=10)
NO.range <- seq(from=est[1,2], to=800, length=10)
Q.range <- cbind(sapply(PM10.range, transform, data=winterdat[,1], par=est[,1]),
sapply(NO.range, transform, data=winterdat[,2], par=est[,2]))
par(mar=c(4.5, 4.5, 3, 1))
set.seed(1)
rl.PN <- plot(x=PNS.hr, type="returns", Q.fix=Q.fix,
Q.range=Q.range, Q.range0=cbind(PM10.range, NO.range), cond=FALSE,
labels=c(expression(PM[10]), "NO"),
main=bquote("Return level for" ~ PM[10]  ~ "and NO" ~
"when" ~ SO[2] ~ ">" ~ .(th[5]) ),
cex.lab=1.4, cex.axis=1.4, labcex=1.2, subsamp=0.05)
################################################################
### Section 2.4                                              ###
### Extremal dependence estimation via Bernstein polynomials ###
################################################################
rm(list=setdiff(ls(), "tstart"))
data(PrecipFrance)
attach(PrecipFrance)
nclust <- 7
PAMmado <- PAMfmado(precip,nclust)
clust <- PAMmado$clustering
d <- 5
stationsn <- matrix(NA, nclust , d)
xx <- simplex(d=d, n=15)
fit <- list(length=nclust)
est <- vector(length=nclust)
set.seed(14342)
for(i in 1:nclust){
stationsn[i,] <- sample(which(clust==i), d)
data_tmp <- precip[,stationsn[i,]]
data_uf_tmp <- trans2UFrechet(data_tmp, type="Empirical")
fit[[i]] <- beed(data_uf_tmp, xx, d, "md", "emp", k=7)
est[i] <- fit[[i]]$extind
}
ExtC <- data.frame(lat = lat[as.vector(t(stationsn))],
lon = lon[as.vector(t(stationsn))],
extc = as.factor(rep(round(est,2),each=d)))
