data(pollution)
f.et05 <- fExtDep(x=PNS, method="PPP", model = "ET", par.start = c(0.5, 0.5, 0.5, 3), trace=2, c=0.05)
f.et10 <- fExtDep(x=PNS, method="PPP", model = "ET", par.start = c(0.5, 0.5, 0.5, 3), trace=2, c=0.10)
###############
### Table 1 ###
###############
f.al <- fExtDep(x=PNS, method="PPP", model = "AL", par.start = c(3, 0.5, 0.5, 0.5), trace=2)
f.pb <- fExtDep(x=PNS, method="PPP", model = "PB", par.start = rep(1,4), trace=2 )
f.td <- fExtDep(x=PNS, method="PPP", model = "TD", par.start = rep(1,3), trace=2 )
f.hr <- fExtDep(x=PNS, method="PPP", model = "HR", par.start = rep(1,3), trace=2 )
