### Figure 11 ###
#################
library(terra)
data(heat)
path <- "https://www.abs.gov.au/statistics/standards/australian-statistical-geography-standard-asgs-edition-3/jul2021-jun2026/access-and-downloads/digital-boundary-files"
file.name <- "SA4_2021_AUST_SHP_GDA2020.zip"
download.file(file.path(path, file.name), destfile=file.name)
unzip(file.name)
geogmel <- vect("SA4_2021_AUST_GDA2020.shp")
geogmel <- geogmel[geogmel$GCC_NAME21 == "Greater Melbourne"]
unlink(list.files(pattern = "SA4_2021_AUST"))
lat <- seq(from=-38.45, by=0.15, length=9)
lon <- seq(from=144.4, by=0.15, length=10)
xx <- expand.grid(lon=lon, lat=lat)
for(m in c("locgrid", "scalegrid", "shapegrid")){
mat <- mget(m)
xx$data <- as.vector(mat[[1]])
rd <- rast(xx, crs=crs(geogmel))
plot(rd, col=map.pal("gyr", 40), plg= list(cex=2),pax=list(cex.axis=2))
lines(geogmel,lwd=3)
}
##################################
### Fit to subset of heat data ###
##################################
sites <- heatdata$sitesEN/100
val <- 0.4
ind_sites <- (abs(sites[,1]) < val & abs(sites [,2]) < val)
sites <- sites[ind_sites,]
x <- heatdata$ufvals[,ind_sites]
hits <- heatdata$hits[,ind_sites]
args1 <- list(Nmax=20L, Nmin=2L, eps = 0.005, logeps = FALSE)
args2 <- list(Nmax=200L, Nmin=20L, eps = 0.005, logeps = TRUE)
est5 <- fExtDepSpat(x=x, model="EST", sites=sites, hit=hits, par0=c(1, 1, 0.5, 0, 0),
DoF=5, acov1 = sites[,1], acov2 = sites[,2],
parallel=TRUE, ncores=6, args1 = args1, args2 = args2, control = list(trace=2))
est5$est
#################
### Figure 12 ###
#################
set.seed(123)
while(TRUE){
z.new <- rExtDepSpat(1, sites, model="EST", cov.mod = "powexp", DoF = 5, nugget = 0,
range = est5$est[1], smooth = est5$est[2],
alpha = est5$est[3:5], acov1 = sites[,1], acov2 = sites[,2],
control = list(method = "exact"))
if(length(unique(as.numeric(z.new$hits))) <= 2) break
}
parmat <- cbind(as.vector(locgrid), as.vector(scalegrid), as.vector(shapegrid))[ind_sites,]
z.new.GEV <- rep(NA, 90)
